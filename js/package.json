{
  "name": "2dautorigger",
  "private": true,
  "version": "0.1.0",
  "description": "JavaScript packages for 2DAutoRigger.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace @rigger2d/editor"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
