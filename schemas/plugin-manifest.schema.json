{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2dautorigger.dev/schemas/plugin-manifest.schema.json",
  "title": "Backend plugin manifest",
  "description": "Describes an installable segmentation/pose backend. The core never ships these; the user installs them and owns their license.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "tasks", "license", "entry_point"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["matte", "parts", "pose", "classify", "inpaint"] }
    },
    "part_vocabulary": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Part ids this backend can emit. Part ids must match a template."
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "description": "SPDX id, or LicenseRef-... when not on the SPDX list." },
        "url": { "type": ["string", "null"] },
        "requires_acceptance": { "type": "boolean", "default": false }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"], "description": "Where the user obtains the weights." },
        "gated": { "type": "boolean", "default": false, "description": "True when access must be requested." },
        "terms_url": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": { "type": ["string", "null"] },
        "packages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entry_point": {
      "type": "string",
      "minLength": 1,
      "description": "Dotted path to the object implementing rigger2d.adapters.base.Adapter."
    },
    "priority": {
      "type": "integer",
      "default": 100,
      "description": "Lower runs first within the fallback chain."
    }
  }
}
